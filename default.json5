{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "LukeEvansTech shared Renovate config — home-operations/renovate-presets plus house defaults. Consume it from any repo with: extends: [\"github>LukeEvansTech/renovate-config\"].",
  extends: [
    // Base bundle from the home-operations ecosystem. Provides:
    //   config:recommended, docker:enableMajor,
    //   helpers:pinGitHubActionDigestsToSemver, :automergeBranch,
    //   :dependencyDashboard, :disableRateLimiting, registry aliases,
    //   the "# renovate:" annotated manager, OCI/CNPG/Talos/Grafana custom
    //   managers, and a semantic-commit policy.
    // Automerge from this bundle is intentionally narrow (GitHub Actions only).
    // The pin below is kept current automatically by the self-update
    // customManager in this repo's .renovaterc.json5.
    "github>home-operations/renovate-presets#2.0.0",

    // ---- House additions on top of the base ----
    "docker:pinDigests", // base pins GitHub Action digests but not image digests
    ":timezone(Europe/London)",
  ],

  // Ask GitHub Copilot to review every Renovate PR (ignored on repos without it).
  reviewers: ["github-copilot[bot]"],
  reviewersSampleSize: 1,

  // Keep the dashboard quiet.
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],

  // House labelling.
  labels: ["dependencies"],
  vulnerabilityAlerts: {
    enabled: true,
    labels: ["security"],
  },
}
